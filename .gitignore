# Private Spring Boot configuration
**/application.properties
**/application-local.properties
**/application-local.yml

# Environment files and secrets
.env
.env.*
!.env.example

# Java / Spring Boot build files
**/target/
*.class

# Logs
*.log
logs/

# IDE files
.vscode/
.idea/
*.iml
.project
.classpath
.settings/

# Operating system files
.DS_Store
Thumbs.db

# Local backup files
*.local-backup
